{
  "title": "Predictive Maintenance Dashboard",
  "uid": "pred-maint-001",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "predictive_maintenance_requests_total",
        "legendFormat": "Requests"
      }],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "steps": [
          { "color": "blue", "value": null }
        ]}
      }}
    },
    {
      "id": 2,
      "title": "Fault Rate",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "rate(predictive_maintenance_faults_total[1m]) / (rate(predictive_maintenance_faults_total[1m]) + rate(predictive_maintenance_normal_total[1m]))",
        "legendFormat": "Fault Rate"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit",
        "color": { "mode": "thresholds" },
        "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.3 },
          { "color": "red", "value": 0.7 }
        ]}
      }}
    },
    {
      "id": 3,
      "title": "Avg Confidence",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "predictive_maintenance_avg_confidence",
        "legendFormat": "Confidence"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit",
        "color": { "mode": "thresholds" },
        "thresholds": { "steps": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 0.8 },
          { "color": "green", "value": 0.95 }
        ]}
      }}
    },
    {
      "id": 4,
      "title": "CUSUM Drift Score",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "predictive_maintenance_cusum_drift_score",
        "legendFormat": "Drift Score"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": {
        "color": { "mode": "thresholds" },
        "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 3 },
          { "color": "red", "value": 5 }
        ]}
      }}
    },
    {
      "id": 5,
      "title": "Prediction Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(predictive_maintenance_latency_ms_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(predictive_maintenance_latency_ms_bucket[1m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(predictive_maintenance_latency_ms_bucket[1m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }}}
    },
    {
      "id": 6,
      "title": "Fault vs Normal Predictions",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(predictive_maintenance_faults_total[1m])",
          "legendFormat": "Faults/sec"
        },
        {
          "expr": "rate(predictive_maintenance_normal_total[1m])",
          "legendFormat": "Normal/sec"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }}}
    },
    {
      "id": 7,
      "title": "Request Throughput",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [{
        "expr": "rate(predictive_maintenance_requests_total[1m])",
        "legendFormat": "Requests/sec"
      }],
      "fieldConfig": { "defaults": {
        "unit": "reqps",
        "color": { "mode": "palette-classic" }
      }}
    }
  ]
}